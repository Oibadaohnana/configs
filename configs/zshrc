zstyle :compinstall filename '/home/benji/.zshrc'
# compinit is ours now -- enableGlobalCompInit=false drops the /etc/zshrc one.
# Full scan ~30ms, -C reuses the dump ~11ms; rescan once a day so newly
# installed completions still land. Anon fn so EXTENDED_GLOB (needed by the
# (#q) qualifier, and not set globally here) does not leak out.
autoload -Uz compinit
() {
  setopt local_options extended_glob
  if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
    touch ~/.zcompdump   # compinit only rewrites on change; refresh so -C can hit
  else
    compinit -C
  fi
}
