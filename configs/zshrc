# Same for aliases: name, what it runs, and the note written above it in this
# file. "aliashelp word" narrows to a matching name, command or note.
aliashelp() {
  local -A notes
  local line buf='' c name
  while IFS= read -r line; do
    case $line in
      '#'*)      c=${${line#\#}## }
                 [[ -z ${c//[-=]/} ]] || buf+="${buf:+ }$c" ;;
      'alias '*) name=${${line#alias }%%=*}; notes[$name]=$buf; buf='' ;;
      *)         buf='' ;;
    esac
  done < ${ZDOTDIR:-$HOME}/.zshrc

  echo ""
  echo "=== Active Zsh Aliases ==="
  echo ""
  local n v note
  for n in ${(ko)aliases}; do
    v=${aliases[$n]} note=${notes[$n]-}
    [[ -n ${1-} && "$n $v $note" != *$1* ]] && continue
    printf '\e[1m%-14s\e[0m %s\n' "$n" "$v"
    [[ -n $note ]] && printf '               \e[2m%s\e[0m\n' "$note"
  done
  echo ""
}
