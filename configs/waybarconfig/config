// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap",
        "custom/media"
    ],

    "hyprland/workspaces": {
        // Not clickable: the module switches by sending "dispatch workspace N"
        // over Hyprland IPC, which a Lua config parses as Lua and rejects.
        // ext/workspaces clicks fine but has no {windows}, so the app icons
        // below would be lost. Switch desktops with Super+1..9 instead.
        "all-outputs": true,
        "format": "{id} {windows}",
        "format-window-separator": " ",
        // The values below are Nerd Font glyphs (installed by nixos/fonts.nix).
        // They live in the Unicode private use area, so they look like blanks
        // in any editor lacking the font -- that is expected, not corruption.
        // To identify one, run the line through `hexdump -C` and look the
        // codepoint up on nerdfonts.com/cheat-sheet.
        "window-rewrite-default": "",
        // Keys match "class<...>" / "title<...>" of each window on the workspace.
        "window-rewrite": {
            "class<firefox>": "",
            "class<kitty>": "",
            "class<code>": "",
            "class<discord>": "󰙯",
            "class<org.kde.dolphin>": "",
            "class<blender>": "",
            "class<com.obsproject.Studio>": "",
            "class<REAPER>": "",
            "class<mumble>": "",
            "class<pavucontrol>": "",
            "class<.blueman-manager-wrapped>": "",
            "class<steam>": "",
            "class<steam_app_.*>": "",
            "class<libreoffice.*>": "",
            "class<org.pwmt.zathura>": "",
            "class<imv>": "",
            "class<mpv>": ""
        }
    },
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        //"mpd",
        "custom/audiosink",
        "pulseaudio",
        "bluetooth",
        "custom/monitors",
        "custom/sleep",
        "memory",
        "network",
        "battery",
        "battery#bat2",
        "clock",
        "tray",
        "custom/power"
    ],


   
 
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": "{:%d.%m.%Y   <span weight='800'>%H:%M</span>}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "rofi -dmenu -l 0 -p 'Calendar' -theme-str '* {font: \"monospace 12\";}' -mesg \"$(cal -3)\""
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },

    // RAM still free, counting down. {avail} is MemAvailable -- what the kernel
    // would actually hand to a new program -- so page cache does not read as
    // "used up" the way {used} on its own would.
    //
    // 32 GB is installed, but firmware and the iGPU carve off a slice before
    // the kernel sees any of it, so /proc/meminfo tops out near 27 GiB and that
    // is what this counts against. states threshold on the *used* percentage,
    // which is the same event from the other side: critical fires as the number
    // shown here runs down to nothing.
    "memory": {
        "interval": 5,
        "format": " {avail:0.1f}G",
        "states": {
            "warning": 85,
            "critical": 95
        },
        "tooltip-format": "{avail:0.1f}G left\n{used:0.1f}G used of {total:0.1f}G ({percentage}%)"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 25,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": " {icon} {capacity}%",
        "format-plugged": " {icon} {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },

    // 4-bar wifi meter. Deliberately NOT a Nerd Font glyph: the icon fonts
    // only offer a single fixed wifi symbol, so the bars are Unicode block
    // elements (U+2581/2583/2585/2587) with the inactive ones dimmed via Pango
    // markup. format-icons is indexed by signalStrength, so the five entries
    // below are 0..4 lit bars.
    "network": {
        "interface": "wlp1s0",
        "interval": 5,
        // signalStrength/20 == lit bars, so <40 is one bar or none.
        "states": {
            "weak": 0,
            "normal": 40
        },
        "format-wifi": "{icon}",
        "format-ethernet": "LAN",
        "format-linked": "{icon}",
        "format-disconnected": "<span color=\"#777777\">▁▃▅▇</span>",
        "format-icons": [
            "<span color=\"#777777\">▁▃▅▇</span>",
            "▁<span color=\"#777777\">▃▅▇</span>",
            "▁▃<span color=\"#777777\">▅▇</span>",
            "▁▃▅<span color=\"#777777\">▇</span>",
            "▁▃▅▇"
        ],
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty -e nmtui"
    },

    "pulseaudio": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{desc}  {volume}%",
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-on": "",
        "format-connected": "",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "~/nixcfg/scripts/focus_or_launch.sh blueman-manager blueman-manager"
    },

    // Which displays are switched on. The tile counts how many of the connected
    // outputs are active; clicking it opens a rofi list for turning them on and
    // off, and that choice is remembered across logins -- see
    // scripts/monitors.sh, which records it, and the "Saved monitor on/off
    // state" section of hyprland.lua, which restores it. Right-click opens
    // wdisplays for arranging them.
    //
    // Polled slowly rather than continuously, because displays change rarely.
    // Whatever does change them -- this menu, Meta+End, a cable being plugged
    // in -- sends RTMIN+8, so the tile updates at once instead of waiting out
    // the interval.
    "custom/monitors": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/monitors.sh waybar",
        "interval": 30,
        "signal": 8,
        "on-click": "~/nixcfg/scripts/monitors.sh menu",
        "on-click-right": "wdisplays"
    },

    // Whether automatic sleep is blocked. Clicking takes a systemd inhibitor
    // covering suspend, the lid switch and idle -- the same lock the sleepoff
    // and sleepon aliases take, so the terminal and the tile always agree.
    // Coffee cup means sleep is blocked, moon means it is allowed.
    //
    // Polled slowly, because nothing changes this but the click or those
    // aliases -- and both send RTMIN+9, so the tile updates at once.
    "custom/sleep": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/sleep_inhibit.sh waybar",
        "interval": 30,
        "signal": 9,
        "on-click": "~/nixcfg/scripts/sleep_inhibit.sh toggle"
    },

    // Which output the volume knob controls -- i.e. the default sink. Sits
    // next to "pulseaudio" on purpose: that module shows the *level*, this one
    // shows the *device*. The script streams JSON continuously (no interval),
    // so the icon reacts the moment a sink changes or a headset connects.
    // The icon itself comes from the script rather than format-icons, because
    // waybar cannot pick one based on sink type.
    "custom/audiosink": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/audio_sink.sh waybar",
        "on-click": "~/nixcfg/scripts/audio_sink.sh menu",
        "on-click-right": "~/nixcfg/scripts/audio_sink.sh next",
        "on-scroll-up": "~/nixcfg/scripts/audio_sink.sh next",
        "on-scroll-down": "~/nixcfg/scripts/audio_sink.sh next"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
        "format" : "",
		"tooltip": false,
		"menu": "on-click",
		/* "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder */
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
