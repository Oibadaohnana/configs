// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 36, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "group/workspaces",
        "hyprland/submap",
        "custom/media"
    ],

    // Desktop tiles: one custom module each, not hyprland/workspaces -- that
    // module's clicks are dead under the Lua config parser. See
    // hypr_workspaces.sh, which also holds the old "window-rewrite" icons.
    // A tile printing empty text hides itself, so empty desktops stay off.
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws1",
            "custom/ws2",
            "custom/ws3",
            "custom/ws4",
            "custom/ws5",
            "custom/ws6",
            "custom/ws7",
            "custom/ws8",
            "custom/ws9",
            "custom/ws10"
        ]
    },

    "custom/ws1": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 1",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 1",
        "interval": 30,
        "signal": 11
    },
    "custom/ws2": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 2",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 2",
        "interval": 30,
        "signal": 11
    },
    "custom/ws3": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 3",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 3",
        "interval": 30,
        "signal": 11
    },
    "custom/ws4": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 4",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 4",
        "interval": 30,
        "signal": 11
    },
    "custom/ws5": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 5",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 5",
        "interval": 30,
        "signal": 11
    },
    "custom/ws6": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 6",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 6",
        "interval": 30,
        "signal": 11
    },
    "custom/ws7": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 7",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 7",
        "interval": 30,
        "signal": 11
    },
    "custom/ws8": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 8",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 8",
        "interval": 30,
        "signal": 11
    },
    "custom/ws9": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 9",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 9",
        "interval": 30,
        "signal": 11
    },
    "custom/ws10": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/hypr_workspaces.sh waybar 10",
        "on-click": "~/nixcfg/scripts/hypr_workspaces.sh focus 10",
        "interval": 30,
        "signal": 11
    },
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        //"mpd",
        "group/tools",
        "memory",
        "network",
        "battery",
        "battery#bat2",
        "group/datetime",
        "tray",
        "custom/power"
    ],

    // Retractable hardware tray: chevron stays, rest slide out leftward on click.
    // Handle takes no on-click -- a click action there swallows the press.
    "group/tools": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "click-to-reveal": true,
            "children-class": "tool"
        },
        "modules": [
            "custom/toolstoggle",
            "custom/audiosink",
            "pulseaudio",
            "bluetooth",
            "custom/monitors",
            "custom/sleep",
            "custom/perfmode"
        ]
    },

    "custom/toolstoggle": {
        "format": "",
        "tooltip": false
    },

    // Same trick for the date: click the time to slide it out leftward. The
    // time is the handle, so it stays put and only the tiles left of it shift.
    "group/datetime": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": [
            "clock",
            "clock#date"
        ]
    },


   
 
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    // Handle for group/datetime, so no on-click -- a click action here would
    // swallow the press and the date would never slide out.
    "clock": {
        // "timezone": "America/New_York",
        "format": "<span weight='800'>{:%H:%M}</span>",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // The hidden half. Keeps the rofi calendar the clock used to open.
    "clock#date": {
        "format": "{:%d.%m.%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "rofi -dmenu -l 0 -p 'Calendar' -theme-str '* {font: \"monospace 12\";}' -mesg \"$(cal -3)\""
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },

    // RAM still free, counting down. {avail} is MemAvailable -- what the kernel
    // would actually hand to a new program -- so page cache does not read as
    // "used up" the way {used} on its own would.
    //
    // 32 GB is installed, but firmware and the iGPU carve off a slice before
    // the kernel sees any of it, so /proc/meminfo tops out near 27 GiB and that
    // is what this counts against. states threshold on the *used* percentage,
    // which is the same event from the other side: critical fires as the number
    // shown here runs down to nothing.
    "memory": {
        "interval": 5,
        "format": " {avail:0.1f}G",
        "states": {
            "warning": 85,
            "critical": 95
        },
        "tooltip-format": "{avail:0.1f}G left\n{used:0.1f}G used of {total:0.1f}G ({percentage}%)"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 25,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": " {icon} {capacity}%",
        "format-plugged": " {icon} {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },

    // 4-bar wifi meter. Deliberately NOT a Nerd Font glyph: the icon fonts
    // only offer a single fixed wifi symbol, so the bars are Unicode block
    // elements (U+2581/2583/2585/2587) with the inactive ones dimmed via Pango
    // markup. format-icons is indexed by signalStrength, so the five entries
    // below are 0..4 lit bars.
    "network": {
        "interface": "wlp1s0",
        "interval": 5,
        // signalStrength/20 == lit bars, so <40 is one bar or none.
        "states": {
            "weak": 0,
            "normal": 40
        },
        "format-wifi": "{icon}",
        "format-ethernet": "LAN",
        "format-linked": "{icon}",
        // Empty format hides the module outright, so the wifi meter only shows
        // up once a wifi link is actually up. The desktop has no wifi hardware
        // at all, so there it stays hidden permanently.
        "format-disconnected": "",
        "format-icons": [
            "<span color=\"#777777\">▁▃▅▇</span>",
            "▁<span color=\"#777777\">▃▅▇</span>",
            "▁▃<span color=\"#777777\">▅▇</span>",
            "▁▃▅<span color=\"#777777\">▇</span>",
            "▁▃▅▇"
        ],
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty -e nmtui"
    },

    "pulseaudio": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{desc}  {volume}%",
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-on": "",
        "format-connected": "",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "~/nixcfg/scripts/focus_or_launch.sh blueman-manager blueman-manager"
    },

    // Which displays are switched on. The tile counts how many of the connected
    // outputs are active; clicking it opens a rofi list for turning them on and
    // off, and that choice is remembered across logins -- see
    // scripts/monitors.sh, which records it, and the "Saved monitor on/off
    // state" section of hyprland.lua, which restores it. Right-click opens
    // wdisplays for arranging them.
    //
    // Polled slowly rather than continuously, because displays change rarely.
    // Whatever does change them -- this menu, Meta+End, a cable being plugged
    // in -- sends RTMIN+8, so the tile updates at once instead of waiting out
    // the interval.
    "custom/monitors": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/monitors.sh waybar",
        "interval": 30,
        "signal": 8,
        "on-click": "~/nixcfg/scripts/monitors.sh menu",
        "on-click-right": "wdisplays"
    },

    // Whether automatic sleep is blocked. Clicking takes a systemd inhibitor
    // covering suspend, the lid switch and idle -- the same lock the sleepoff
    // and sleepon aliases take, so the terminal and the tile always agree.
    // Coffee cup means sleep is blocked, moon means it is allowed.
    //
    // Polled slowly, because nothing changes this but the click or those
    // aliases -- and both send RTMIN+9, so the tile updates at once.
    "custom/sleep": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/sleep_inhibit.sh waybar",
        "interval": 30,
        "signal": 9,
        "on-click": "~/nixcfg/scripts/sleep_inhibit.sh toggle"
    },

    // How hard the machine is allowed to work. Hyprland has no performance
    // mode of its own, so each mode is really two things at once: a
    // power-profiles-daemon profile (clocks, power limits, fan curve) and a
    // set of Hyprland render settings (blur, animations, transparency,
    // tearing). Bolt is performance and the default, scales is balanced, leaf
    // is power saver -- see scripts/perfmode.sh.
    //
    // Left-click cycles, right-click opens a rofi list, scroll steps either
    // way. Polled slowly because only those change it, and each of them sends
    // RTMIN+10, so the tile updates at once instead of waiting out the
    // interval.
    "custom/perfmode": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/perfmode.sh waybar",
        "interval": 30,
        "signal": 10,
        "on-click": "~/nixcfg/scripts/perfmode.sh next",
        "on-click-right": "~/nixcfg/scripts/perfmode.sh menu",
        "on-scroll-up": "~/nixcfg/scripts/perfmode.sh prev",
        "on-scroll-down": "~/nixcfg/scripts/perfmode.sh next"
    },

    // Which output the volume knob controls -- i.e. the default sink. Sits
    // next to "pulseaudio" on purpose: that module shows the *level*, this one
    // shows the *device*. The script streams JSON continuously (no interval),
    // so the icon reacts the moment a sink changes or a headset connects.
    // The icon itself comes from the script rather than format-icons, because
    // waybar cannot pick one based on sink type.
    "custom/audiosink": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/nixcfg/scripts/audio_sink.sh waybar",
        "on-click": "~/nixcfg/scripts/audio_sink.sh menu",
        "on-click-right": "~/nixcfg/scripts/audio_sink.sh next",
        "on-scroll-up": "~/nixcfg/scripts/audio_sink.sh next",
        "on-scroll-down": "~/nixcfg/scripts/audio_sink.sh next"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
        "format" : "",
		"tooltip": false,
		"menu": "on-click",
		/* "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder */
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
