########################################
# Variables
########################################
$mod = SUPER
$term = kitty
$menu = rofi -show drun

########################################
# Monitors
########################################
# Desktop
monitor = DP-3, 2560x1440@180, 0x0, 1.25
monitor = HDMI-A-1, disable

# Workspace 4 always lives on the secondary screen
workspace = 4, monitor:HDMI-A-1

# Laptop (uncomment when on framework)
# monitor = DP-10, 2560x1440@144, 1128x0, 1
# monitor = DP-11, 2560x1440@144, 1128x0, 1
# monitor = DP-2,  2560x1440@144, 0x0, 1
# monitor = eDP-1, preferred, 0x0, 1.5

########################################
# Input
########################################
input {
    kb_layout = de
    kb_options = caps:super
    sensitivity = 0
    accel_profile = flat

    touchpad {
        natural_scroll = false
        tap-to-click = true
        middle_button_emulation = true
        scroll_factor = 0.5
    }
}

########################################
# General / Appearance
########################################
general {
    gaps_in = 0
    gaps_out = 0
    border_size = 1
    col.active_border = rgba(ff8800aa)
    col.inactive_border = rgba(222222ff)
    layout = dwindle
}

decoration {
    rounding = 0
    active_opacity = 1.0
    inactive_opacity = 0.9
    blur {
        enabled = true
        size = 5
        passes = 2
    }
}

misc {
    background_color = 0xFF000000
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
}

ecosystem {
    no_update_news = true
    no_donation_nag = true
}

animations {
    enabled = false
}

dwindle {
    preserve_split = true
}

########################################
# Autostart
########################################
exec-once = waybar -c ~/nixcfg/configs/waybarconfig/config -s ~/nixcfg/configs/waybarconfig/style.css
exec-once = mako
exec-once = wlsunset -l 50.59 -L 8.69 -t 3000 -T 6500
exec-once = hyprpaper
exec-once = wl-paste --watch cliphist store

########################################
# Apps
########################################
bind = $mod,       RETURN, exec, $term
bind = $mod,       F2,     exec, firefox
bind = $mod,       F1,     exec, pavucontrol
bind = $mod,       F3,     exec, blueman-manager
bind = $mod,       F4,     exec, wdisplays
bind = $mod,       D,      exec, $menu
# Meta+V = Show Clipboard (matches Plasma)
bind = $mod,       V,      exec, cliphist list | rofi -dmenu | cliphist decode | wl-copy
# Meta+End = Toggle gaming display (matches Plasma)
bind = $mod,       End,    exec, hyprctl keyword monitor HDMI-A-1,1280x720@60,auto,1

########################################
# Session (matches Plasma)
########################################
# Meta+L = Lock Session
bind = $mod,       L,      exec, hyprlock
# Ctrl+Alt+Del = Logout menu
bind = CTRL ALT,   DELETE, exec, wlogout
# Meta+Shift+P = Shut Down
bind = $mod SHIFT, P,      exec, systemctl poweroff

########################################
# Windows (matches Plasma)
########################################
# Meta+Alt+Q / Alt+F4 = Close Window
bind = $mod ALT,   Q,      killactive
bind = ALT,        F4,     killactive
# Meta+Ctrl+Esc = Kill Window
bind = $mod CTRL,  ESCAPE, exec, hyprctl kill
# Meta+F / Meta+PgUp = Maximize
bind = $mod,       F,      fullscreen, 1
bind = $mod,       Prior,  fullscreen, 1
# Toggle floating
bind = $mod SHIFT, SPACE,  togglefloating
# Cycle windows
bind = $mod,       SPACE,  cyclenext
# Reload config
bind = $mod SHIFT, C,      exec, hyprctl reload
# Exit session
bind = $mod SHIFT, E,      exit

########################################
# Focus (Meta+Arrow and Meta+Alt+Arrow, matches Plasma)
########################################
bind = $mod,     left,  movefocus, l
bind = $mod,     right, movefocus, r
bind = $mod,     up,    movefocus, u
bind = $mod,     down,  movefocus, d
bind = $mod ALT, left,  movefocus, l
bind = $mod ALT, right, movefocus, r
bind = $mod ALT, up,    movefocus, u
bind = $mod ALT, down,  movefocus, d

########################################
# Move windows
########################################
# Meta+Shift+Left/Right = Move to Prev/Next Screen (matches Plasma)
bind = $mod SHIFT, left,  movewindow, mon:-1
bind = $mod SHIFT, right, movewindow, mon:+1
# Move within tiling layout (vim-style)
bind = $mod SHIFT, H, movewindow, l
bind = $mod SHIFT, J, movewindow, d
bind = $mod SHIFT, K, movewindow, u
bind = $mod SHIFT, L, movewindow, r

########################################
# Workspaces (matches Plasma)
########################################
# Meta+1-9 = Switch to Desktop
bind = $mod, 1, workspace, 1
bind = $mod, 2, workspace, 2
bind = $mod, 3, workspace, 3
bind = $mod, 4, workspace, 4
bind = $mod, 5, workspace, 5
bind = $mod, 6, workspace, 6
bind = $mod, 7, workspace, 7
bind = $mod, 8, workspace, 8
bind = $mod, 9, workspace, 9
bind = $mod, 0, workspace, 10

# Meta+Ctrl+Left/Right/Up/Down = Switch Desktop (matches Plasma)
bind = $mod CTRL, left,  workspace, -1
bind = $mod CTRL, right, workspace, +1
bind = $mod CTRL, up,    workspace, +1
bind = $mod CTRL, down,  workspace, -1

# Meta+Ctrl+Shift+Direction = Move Window to Desktop (matches Plasma)
bind = $mod CTRL SHIFT, left,  movetoworkspace, -1
bind = $mod CTRL SHIFT, right, movetoworkspace, +1

# Meta+Shift+1-9 = Move Window to Numbered Desktop (bonus)
bind = $mod SHIFT, 1, movetoworkspace, 1
bind = $mod SHIFT, 2, movetoworkspace, 2
bind = $mod SHIFT, 3, movetoworkspace, 3
bind = $mod SHIFT, 4, movetoworkspace, 4
bind = $mod SHIFT, 5, movetoworkspace, 5
bind = $mod SHIFT, 6, movetoworkspace, 6
bind = $mod SHIFT, 7, movetoworkspace, 7
bind = $mod SHIFT, 8, movetoworkspace, 8
bind = $mod SHIFT, 9, movetoworkspace, 9
bind = $mod SHIFT, 0, movetoworkspace, 10

########################################
# Window switching / Alt-Tab (matches Plasma)
########################################
bind = ALT,        Tab, cyclenext
bind = ALT SHIFT,  Tab, cyclenext, prev
bind = $mod,       Tab, cyclenext
bind = $mod SHIFT, Tab, cyclenext, prev

########################################
# Scratchpad
########################################
bind = $mod,       MINUS, movetoworkspacesilent, special:scratchpad
bind = $mod SHIFT, MINUS, togglespecialworkspace, scratchpad

########################################
# Keyboard layout (matches Plasma Meta+Alt+K)
# Note: Meta+Alt+L conflicts with lock (Meta+L) so using Meta+Alt+P for prev
########################################
bind = $mod ALT, K, exec, hyprctl switchxkblayout all next
bind = $mod ALT, P, exec, hyprctl switchxkblayout all prev

########################################
# Resize submap
########################################
bind = $mod, R, submap, resize
submap = resize
    bind = , H,      resizeactive, -10 0
    bind = , J,      resizeactive, 0 10
    bind = , K,      resizeactive, 0 -10
    bind = , L,      resizeactive, 10 0
    bind = , left,   resizeactive, -10 0
    bind = , down,   resizeactive, 0 10
    bind = , up,     resizeactive, 0 -10
    bind = , right,  resizeactive, 10 0
    bind = , RETURN, submap, reset
    bind = , ESCAPE, submap, reset
submap = reset

########################################
# Media / Volume / Brightness (matches Plasma)
########################################
bindel = ,      XF86AudioRaiseVolume,  exec, ~/nixcfg/scripts/volume_notify.sh up 5
bindel = ,      XF86AudioLowerVolume,  exec, ~/nixcfg/scripts/volume_notify.sh down 5
bindl  = ,      XF86AudioMute,         exec, ~/nixcfg/scripts/volume_notify.sh mute
bindl  = ,      XF86AudioMicMute,      exec, ~/nixcfg/scripts/volume_notify.sh mic-mute
# F9 = Push-to-mute mic (mutes the default source, e.g. for Discord)
bindl  = ,      F9,                    exec, ~/nixcfg/scripts/volume_notify.sh mic-mute
bindel = SHIFT, XF86AudioRaiseVolume,  exec, ~/nixcfg/scripts/volume_notify.sh up 1
bindel = SHIFT, XF86AudioLowerVolume,  exec, ~/nixcfg/scripts/volume_notify.sh down 1
bindl  = ,      XF86AudioPlay,         exec, playerctl play-pause
bindl  = ,      XF86AudioPause,        exec, playerctl play-pause
bindl  = ,      XF86AudioNext,         exec, playerctl next
bindl  = ,      XF86AudioPrev,         exec, playerctl previous
bindl  = ,      XF86AudioStop,         exec, playerctl stop
bindl  = ,      XF86AudioRewind,       exec, playerctl position 5-
bindl  = ,      XF86AudioForward,      exec, playerctl position 5+
bindel = ,      XF86MonBrightnessUp,   exec, brightnessctl set 5%+
bindel = ,      XF86MonBrightnessDown, exec, brightnessctl set 5%-
bindel = SHIFT, XF86MonBrightnessUp,   exec, brightnessctl set 1%+
bindel = SHIFT, XF86MonBrightnessDown, exec, brightnessctl set 1%-

########################################
# Screenshot (matches Plasma Spectacle)
########################################
bind = $mod SHIFT, Print, exec, /home/benji/nixcfg/scripts/screenshot.sh
bind = ,           F12,   exec, /home/benji/nixcfg/scripts/screenshot.sh

########################################
# Mouse — drag/resize floating windows
########################################
bindm = $mod, mouse:272, movewindow
bindm = $mod, mouse:273, resizewindow
