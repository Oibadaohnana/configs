# Default applications. Managed in ~/nixcfg/configs/mimeapps.list and
# symlinked into place by scripts/symlinks.sh -- edit it there, not here.
#
# The video list is mpv.desktop's own MimeType field verbatim. The image
# list is hand-picked: mpv.desktop declares no image types at all, so
# without these entries nothing would route photos to it. SVG is omitted
# on purpose -- it is vector, which ffmpeg cannot rasterise for mpv.

[Default Applications]
application/pdf=firefox.desktop;
text/plain=code.desktop;
video/3gp=mpv.desktop;
video/3gpp=mpv.desktop;
video/3gpp2=mpv.desktop;
video/avi=mpv.desktop;
video/divx=mpv.desktop;
video/dv=mpv.desktop;
video/fli=mpv.desktop;
video/flv=mpv.desktop;
video/mkv=mpv.desktop;
video/mp2t=mpv.desktop;
video/mp4=mpv.desktop;
video/mp4v-es=mpv.desktop;
video/mpeg=mpv.desktop;
video/msvideo=mpv.desktop;
video/ogg=mpv.desktop;
video/quicktime=mpv.desktop;
video/vnd.avi=mpv.desktop;
video/vnd.divx=mpv.desktop;
video/vnd.mpegurl=mpv.desktop;
video/vnd.rn-realvideo=mpv.desktop;
video/webm=mpv.desktop;
video/x-avi=mpv.desktop;
video/x-flc=mpv.desktop;
video/x-flic=mpv.desktop;
video/x-flv=mpv.desktop;
video/x-m4v=mpv.desktop;
video/x-matroska=mpv.desktop;
video/x-mpeg2=mpv.desktop;
video/x-mpeg3=mpv.desktop;
video/x-ms-afs=mpv.desktop;
video/x-ms-asf=mpv.desktop;
video/x-msvideo=mpv.desktop;
video/x-ms-wmv=mpv.desktop;
video/x-ms-wmx=mpv.desktop;
video/x-ms-wvxvideo=mpv.desktop;
video/x-ogm=mpv.desktop;
video/x-ogm+ogg=mpv.desktop;
video/x-theora=mpv.desktop;
video/x-theora+ogg=mpv.desktop;
image/jpeg=mpv.desktop;
image/png=mpv.desktop;
image/gif=mpv.desktop;
image/webp=mpv.desktop;
image/bmp=mpv.desktop;
image/tiff=mpv.desktop;
image/avif=mpv.desktop;
image/heif=mpv.desktop;
image/heic=mpv.desktop;
image/jxl=mpv.desktop;
image/x-portable-pixmap=mpv.desktop;
image/x-xpixmap=mpv.desktop;
x-scheme-handler/claude-cli=claude-code-url-handler.desktop;
x-scheme-handler/discord-1185990483143569448=Beyond-All-Reason.desktop;
x-scheme-handler/tg=org.telegram.desktop.desktop;
x-scheme-handler/tonsite=org.telegram.desktop.desktop;

